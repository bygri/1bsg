---
layout: page
page_title: Youth Inquiry
date: Last Modified

meta_description: |
  Scouting is about fun, friends, adventure and so much more. Inquire now for
  your free 4 week trial.
---
{% import "component/ui.njk" as ui with context %}

<section class="bg-sand contour-light {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl">
    <div class="{{ ui.proseLead | safe }}">
      {% markdown %}{% include "../_content/youth-inquiry/intro.md" %}{% endmarkdown %}
    </div>
    <div class="mt-6">{{ ui.callout("Please make contact first", "youth-inquiry/notice.md", "warning") }}</div>
  </div>
</section>

<section class="bg-paper {{ ui.band | safe }}">
  <div class="mx-auto max-w-2xl">
    <form name="youth-inquiry" netlify action="/youth-inquiry/success/" method="POST">
      <input type="hidden" name="subject" data-remove-prefix value="Youth Inquiry">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {{ ui.field("Your name", "parent-name", span=2) }}
        {{ ui.field("Email", "email", type="email", autocomplete="email") }}
        {{ ui.field("Phone", "phone", type="tel", autocomplete="tel") }}
        {{ ui.field("Message", "message", rows=5, span=2,
                    hint="Please include your children's full names and ages.") }}
        <div class="mt-2 sm:col-span-2">
          {{ ui.button("Send Inquiry", none, "primary", "lg", true) }}
        </div>
      </div>
    </form>
  </div>
</section>
