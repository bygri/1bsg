---
layout: page
page_title: Hall Hire
date: Last Modified

meta_description: |
  For group classes, birthday parties or a base camp for exploring the
  Upper Blue Mountains, book the 1st Blackheath Scout Hall for your
  venue needs.
---
{% import "component/ui.njk" as ui with context %}

<section class="relative flex min-h-[clamp(340px,48vh,440px)] items-end overflow-hidden bg-hero">
  <img class="absolute inset-0 h-full w-full object-cover photo-dim-hero" alt="" src="/assets/img/hall-hero.jpg">
  <div class="absolute inset-0 bg-veil"></div>
  <div class="relative mx-auto w-full max-w-6xl pb-10 pt-14 text-white lg:pb-12 lg:pt-16 {{ ui.gutter | safe }}">
    <div class="mb-3 text-sm font-black uppercase tracking-caps text-eucalypt-light">2 Park Lane, Blackheath</div>
    <h1 class="mb-4 max-w-[18ch] text-4xl font-black leading-tight tracking-display text-white">{% filter trim %}{% include "../_content/hallhire/heading.txt" %}{% endfilter %}</h1>
    <div class="mt-6 flex flex-wrap gap-3">
      {{ ui.button("Make a booking inquiry", "#inquiry", "onDark") }}
    </div>
  </div>
</section>

<section class="bg-paper contour-light {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl">
    <div class="{{ ui.proseLead | safe }}">
      {% markdown %}{% include "../_content/hallhire/hallhire.md" %}{% endmarkdown %}
    </div>
    <div class="my-6">{{ ui.callout("Please note", "hallhire/notice.md", "warning") }}</div>
    <div class="{{ ui.prose | safe }}">
      {% markdown %}{% include "../_content/hallhire/location.md" %}{% endmarkdown %}
    </div>
  </div>
</section>

<section class="bg-sand {{ ui.band | safe }}">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-8 max-w-[26ch] text-2xl font-black tracking-display text-ink">The Hall</h2>
    {{ ui.photo(hallhire.hero_photo.url, hallhire.hero_photo.alt, hallhire.hero_photo.caption, "16/9") }}
    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {%- for photo in hallhire.photos %}
      {{ ui.photo(photo.url, photo.alt, photo.caption, "3/2") }}
      {%- endfor %}
    </div>
  </div>
</section>

<section class="bg-paper {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl">
    <h2 class="mb-8 max-w-[26ch] text-2xl font-black tracking-display text-ink">Schedule of fees</h2>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[26rem] border-collapse tabular-nums">
        <thead>
          <tr>
            {%- for value in hallhire_rates[0] %}
            <th class="border-b-2 border-ink px-4 py-3 text-xs font-black uppercase tracking-caps {{ 'text-left text-bark-400' if loop.first else 'text-right text-ink' }}">{{ value }}</th>
            {%- endfor %}
          </tr>
        </thead>
        <tbody>
          {%- for row in hallhire_rates.slice(1) %}
          <tr class="{{ 'bg-sand' if loop.index0 is odd }}">
            {%- for value in row %}
            {%- if loop.first %}
            <th class="border-b border-bark-100 px-4 py-3 text-left font-bold text-bark-700">{{ value }}</th>
            {%- else %}
            <td class="border-b border-bark-100 px-4 py-3 text-right">{{ value }}</td>
            {%- endif %}
            {%- endfor %}
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="bg-sand {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl">
    <h2 class="mb-4 max-w-[26ch] text-2xl font-black tracking-display text-ink">Upcoming bookings</h2>
    <p>
      Review our calendar to see when the Hall is available for hire, then send a booking inquiry and
      the Hall Hire Officer will confirm availability with you.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      {{ ui.button("Open the calendar in a new window", hallhire.calendar_url, "secondary", attrs='target="_blank" rel="noopener noreferrer"') }}
      {{ ui.button("Make a booking inquiry", "#inquiry") }}
    </div>
  </div>
  <div class="mx-auto mt-10 max-w-7xl">
    <iframe class="h-[38rem] w-full rounded-card border border-bark-200" title="1st Blackheath Scout Hall booking calendar" src="{{ hallhire.calendar_url }}"></iframe>
  </div>
</section>

<section id="inquiry" class="scroll-mt-24 bg-paper {{ ui.band | safe }}">
  <div class="mx-auto max-w-2xl">
    <div class="{{ ui.prose | safe }} mb-8">
      {% markdown %}{% include "../_content/hallhire/inquiry/intro.md" %}{% endmarkdown %}
    </div>

    <form name="hallhire-inquiry" netlify action="/hall-hire/success/" method="POST">
      <input type="hidden" name="subject" data-remove-prefix value="Hall Hire Inquiry">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {{ ui.field("Your name", "parent-name", span=2) }}
        {{ ui.field("Email", "email", type="email", autocomplete="email") }}
        {{ ui.field("Phone", "phone", type="tel", autocomplete="tel") }}
        {{ ui.field("Dates and times of booking", "dates", span=2) }}
        {{ ui.field("Purpose of booking", "purpose", span=2) }}
        {{ ui.field("Estimated number of people", "num-people", span=2) }}
        {{ ui.field("Comments", "message", rows=5, span=2,
                    hint="Please advise if you need any extra equipment such as tables and chairs or BBQ, and include quantities.") }}
        <div class="mt-2 sm:col-span-2">
          {{ ui.button("Send Inquiry", none, "primary", "lg", true) }}
        </div>
      </div>
    </form>
  </div>
</section>

<section class="bg-paper {{ ui.gutter | safe }} pb-11 sm:pb-14 lg:pb-20">
  <div class="mx-auto max-w-4xl">
    <div class="rounded-card border border-bark-100 border-b-2 border-b-bark-200 bg-card p-6 shadow-sm">
      <img class="mb-3 block h-[34px] w-auto" alt="Bendigo Bank" src="/assets/img/bendigo-bank-300x52.png">
      <div class="{{ ui.prose | safe }} prose-p:mb-0">
        {% markdown %}{% include "../_content/hallhire/bendigo.md" %}{% endmarkdown %}
      </div>
    </div>
  </div>
</section>
