{% import "component/ui.njk" as ui with context %}

<section class="bg-sand contour-light {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl {{ ui.proseLead | safe }}">
    {% markdown %}{% include "../_content/register/index.md" %}{% endmarkdown %}
  </div>
</section>

<section class="bg-paper {{ ui.band | safe }}">
  <div class="mx-auto grid max-w-4xl gap-4">
    {%- for choice in registration %}
    {% call ui.option(choice.title, choice.url) %}{{ choice.description }}{% endcall %}
    {%- endfor %}
  </div>
</section>
