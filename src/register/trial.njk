---
layout: page
page_title: Trial Membership
date: Last Modified

no_robots: true
---
{% import "component/ui.njk" as ui with context %}

<section class="bg-sand contour-light {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl {{ ui.proseLead | safe }}">
    {% markdown %}{% include "../_content/register/trial.md" %}{% endmarkdown %}
  </div>
</section>

<section class="bg-paper {{ ui.band | safe }}">
  <div class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
    {%- for section in sections %}
    {% call ui.option(section.name, section.trial_url, section.small_img, section.img) %}
      {{ section.ages }}<br>{{ section.day }} {{ section.time }}
    {% endcall %}
    {%- endfor %}
  </div>
</section>
