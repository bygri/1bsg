---
layout: page
date: Last Modified

meta_description: |
  Try Scouting in the Upper Blue Mountains. We pursue an active, outdoors
  program and encourage youth to discover what's possible. Scouting is
  about fun, friends, adventure and so much more.

---
{% import "component/ui.njk" as ui with context %}

<section class="relative flex min-h-[clamp(420px,62vh,560px)] items-end overflow-hidden bg-navy">
  <img class="absolute inset-0 h-full w-full object-cover" alt="" src="/assets/img/hero-lookout-1920x1080.jpg">
  <div class="absolute inset-0 bg-veil"></div>
  <div class="relative mx-auto w-full max-w-6xl pb-10 pt-14 text-white lg:pb-12 lg:pt-16 {{ ui.gutter | safe }}">
    <div class="mb-3 text-sm font-black uppercase tracking-caps text-eucalypt-light">Upper Blue Mountains</div>
    <div class="{{ ui.proseInvert | safe }} prose-h1:text-4xl prose-h1:max-w-[18ch] prose-p:max-w-[52ch]">
      {% markdown %}{% include "./_content/index/join-intro.md" %}{% endmarkdown %}
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      {{ ui.button("Inquire Now", "/youth-inquiry/", "onDark", "lg") }}
    </div>
  </div>
</section>

<section class="bg-paper contour-light {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl">
    <div class="{{ ui.proseLead | safe }}">
      {% markdown %}{% include "./_content/index/join-about.md" %}{% endmarkdown %}
    </div>
    {{ ui.photo("/assets/img/district-camp-2024-2048x1152.jpg",
                "Ten Scouts displaying a trophy shield and a flag",
                none, "16/9", "mt-8") }}
  </div>
</section>

<section class="bg-sand {{ ui.band | safe }}">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {%- for section in sections %}
      {{ ui.sectionCard(section, section.trial_url) }}
      {%- endfor %}
    </div>

    <div class="mt-10 text-center">
      {{ ui.button("Youth Trial Inquiry", "/youth-inquiry/", "primary", "lg") }}
    </div>
  </div>
</section>

<section class="bg-paper {{ ui.band | safe }}">
  <div class="mx-auto max-w-4xl">
    <div class="{{ ui.proseLead | safe }}">
      {% markdown %}{% include "./_content/index/join-footer.md" %}{% endmarkdown %}
    </div>
    <div class="mt-6">{{ ui.callout("Vouchers and family support", "index/join-vouchers.md", "info") }}</div>
    {{ ui.photo("/assets/img/hike-bridge-2000x1125.jpg",
                "Five Scouts with backpacks hiking over a bridge",
                none, "16/9", "mt-10") }}
  </div>
</section>

<section id="volunteer" class="bg-eucalypt contour-dark {{ ui.band | safe }}">
  <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="{{ ui.proseInvert | safe }} prose-h1:text-2xl">
      {% markdown %}{% include "./_content/index/adult-volunteering.md" %}{% endmarkdown %}
      <div class="not-prose mt-6">
        {{ ui.button("Learn more", "/volunteering/", "onDark") }}
      </div>
    </div>
    {{ ui.photo("/assets/img/leader-lookout-2475x1392.jpg",
                "A Leader pointing out the view across the escarpment to a group of Scouts resting at a clifftop lookout",
                none, "16/9") }}
  </div>
</section>

<section id="hallhire" class="bg-paper {{ ui.band | safe }}">
  <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-10">
    {{ ui.photo("/assets/img/hall.jpg", "Interior of Blackheath Scout Hall", none, "16/10") }}
    <div class="{{ ui.proseLead | safe }} prose-h1:text-2xl">
      {% markdown %}{% include "./_content/index/hallhire.md" %}{% endmarkdown %}
      <div class="not-prose mt-6">
        {{ ui.button("Find out more", "/hall-hire/", "secondary") }}
      </div>
    </div>
  </div>
</section>

<section id="contact" class="bg-sand {{ ui.band | safe }}">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-4 max-w-[26ch] text-2xl font-black tracking-display text-navy">Contacts</h2>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {%- for contact in contacts %}
      {{ ui.contactCard(contact) }}
      {%- endfor %}
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {%- for content in contacts_extras %}
      <div>
        <h3 class="mb-2 text-md font-black tracking-display text-navy">{{ content.title }}</h3>
        <p class="mb-0">{{ content.body|safe }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
